{
	"name": "@surrealdb/langchain-adapter",
	"private": true,
	"description": "SurrealDB integration for LangChain.js and LangGraph.js",
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"scripts": {
		"build": "bun run --filter '@surrealdb/*' build",
		"typecheck": "tsc --noEmit",
		"test": "bun run --filter '@surrealdb/*' test",
		"test:integration": "bun run --filter '@surrealdb/*' test:integration",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"clean": "rm -rf packages/*/dist examples/*/dist",
		"validate:versions": "bun run scripts/validate-versions.ts"
	},
	"engines": {
		"bun": ">=1.0.0",
		"node": ">=22"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@types/node": "^22.0.0",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^3.1.3"
	},
	"packageManager": "bun@1.2.21"
}
