{
	"name": "@surrealdb/langchain-core",
	"version": "0.1.0",
	"description": "Shared SurrealDB connection, schema and query helpers plus a Spectron HTTP client for the SurrealDB LangChain.js / LangGraph.js adapters",
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./spectron": {
			"import": {
				"types": "./dist/spectron.d.ts",
				"default": "./dist/spectron.js"
			},
			"require": {
				"types": "./dist/spectron.d.cts",
				"default": "./dist/spectron.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"license": "Apache-2.0",
	"engines": {
		"bun": ">=1.0.0",
		"node": ">=22"
	},
	"dependencies": {
		"@surrealdb/spectron": "^1.0.0-alpha.5",
		"surrealdb": "^2.0.3"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^3.1.3"
	},
	"files": [
		"dist",
		"src",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts"
	}
}
