{
	"name": "@surrealdb/langchain",
	"version": "0.2.0",
	"description": "SurrealDB integrations for LangChain.js \u2014 vector store, retrievers, tools, chat model, record manager, caches and chat history",
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./vectorstores": {
			"import": {
				"types": "./dist/vectorstores.d.ts",
				"default": "./dist/vectorstores.js"
			},
			"require": {
				"types": "./dist/vectorstores.d.cts",
				"default": "./dist/vectorstores.cjs"
			}
		},
		"./retrievers": {
			"import": {
				"types": "./dist/retrievers.d.ts",
				"default": "./dist/retrievers.js"
			},
			"require": {
				"types": "./dist/retrievers.d.cts",
				"default": "./dist/retrievers.cjs"
			}
		},
		"./tools": {
			"import": {
				"types": "./dist/tools.d.ts",
				"default": "./dist/tools.js"
			},
			"require": {
				"types": "./dist/tools.d.cts",
				"default": "./dist/tools.cjs"
			}
		},
		"./chat_models": {
			"import": {
				"types": "./dist/chat_models.d.ts",
				"default": "./dist/chat_models.js"
			},
			"require": {
				"types": "./dist/chat_models.d.cts",
				"default": "./dist/chat_models.cjs"
			}
		},
		"./indexes": {
			"import": {
				"types": "./dist/indexes.d.ts",
				"default": "./dist/indexes.js"
			},
			"require": {
				"types": "./dist/indexes.d.cts",
				"default": "./dist/indexes.cjs"
			}
		},
		"./caches": {
			"import": {
				"types": "./dist/caches.d.ts",
				"default": "./dist/caches.js"
			},
			"require": {
				"types": "./dist/caches.d.cts",
				"default": "./dist/caches.cjs"
			}
		},
		"./chat_history": {
			"import": {
				"types": "./dist/chat_history.d.ts",
				"default": "./dist/chat_history.js"
			},
			"require": {
				"types": "./dist/chat_history.d.cts",
				"default": "./dist/chat_history.cjs"
			}
		},
		"./callbacks": {
			"import": {
				"types": "./dist/callbacks.d.ts",
				"default": "./dist/callbacks.js"
			},
			"require": {
				"types": "./dist/callbacks.d.cts",
				"default": "./dist/callbacks.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"license": "Apache-2.0",
	"engines": {
		"bun": ">=1.0.0",
		"node": ">=22"
	},
	"dependencies": {
		"@surrealdb/langchain-core": "workspace:*",
		"surrealdb": "^2.0.8"
	},
	"peerDependencies": {
		"@langchain/core": "^1.2.9",
		"zod": "^3.25.76 || ^4"
	},
	"devDependencies": {
		"@langchain/core": "^1.2.9",
		"@types/node": "^22.0.0",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^3.1.3",
		"zod": "^3.25.76"
	},
	"files": [
		"dist",
		"src",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts"
	}
}
