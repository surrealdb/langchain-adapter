{
	"name": "@surrealdb/langchain",
	"version": "0.1.0",
	"description": "SurrealDB integrations for LangChain.js — vector store, retriever, tools, chat model wrapper",
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./vectorstores": {
			"import": {
				"types": "./dist/vectorstores.d.ts",
				"default": "./dist/vectorstores.js"
			},
			"require": {
				"types": "./dist/vectorstores.d.cts",
				"default": "./dist/vectorstores.cjs"
			}
		},
		"./retrievers": {
			"import": {
				"types": "./dist/retrievers.d.ts",
				"default": "./dist/retrievers.js"
			},
			"require": {
				"types": "./dist/retrievers.d.cts",
				"default": "./dist/retrievers.cjs"
			}
		},
		"./tools": {
			"import": {
				"types": "./dist/tools.d.ts",
				"default": "./dist/tools.js"
			},
			"require": {
				"types": "./dist/tools.d.cts",
				"default": "./dist/tools.cjs"
			}
		},
		"./chat_models": {
			"import": {
				"types": "./dist/chat_models.d.ts",
				"default": "./dist/chat_models.js"
			},
			"require": {
				"types": "./dist/chat_models.d.cts",
				"default": "./dist/chat_models.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"license": "Apache-2.0",
	"engines": {
		"bun": ">=1.0.0",
		"node": ">=22"
	},
	"dependencies": {
		"@surrealdb/langchain-core": "workspace:*",
		"surrealdb": "^2.0.3",
		"zod": "^3.23.0"
	},
	"peerDependencies": {
		"@langchain/core": ">=0.3.0 <1.0.0"
	},
	"devDependencies": {
		"@langchain/core": "^0.3.0",
		"@types/node": "^22.0.0",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^3.1.3"
	},
	"files": [
		"dist",
		"src",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts"
	}
}
